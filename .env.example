# HAS_PrepperDisk (Docker & Web Sürümü) Ortam Değişkenleri / Environment Variables

# Web arayüzünün çalışacağı port / Web UI port
PORT=7572

# Yönetici şifresi (paket silme ve kritik işlemler için) / Admin password for deletion
ADMIN_PASSWORD=prepper

# İndirilen ZIM arşivlerinin tutulacağı klasör yolu / Host directory for downloaded ZIMs
# Harici bir SSD veya klasör bağlamak isterseniz tam yolunu yazabilirsiniz (örn: /mnt/ssd/library)
PREPPER_LIBRARY_PATH=./library

# Saat dilimi / Timezone
TZ=Europe/Istanbul
